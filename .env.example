# Local environment variables for finm37000-grp2.
#
# Setup (each member does this once, with their own key):
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
# Then paste your key below in `.env`.
#
# `.env` is git-ignored. Never commit your real API key.

# Databento API key: https://databento.com/portal/keys
# Every member uses their own key. Historical data requests are billed to the
# account that owns the key, so check the estimated cost before large pulls.
DATABENTO_API_KEY=db-REPLACE_WITH_YOUR_KEY
